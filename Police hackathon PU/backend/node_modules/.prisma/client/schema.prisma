generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Classification {
  SOURCE_FACT
  DERIVED_ANALYTIC
  APPLICATION_METADATA
  DEMO_DATA
}

enum DrugCategory {
  OPIOIDS_FENTANYL
  STIMULANTS
  CANNABIS
  PSYCHEDELICS
  PRESCRIPTION_OTHER
}

enum EntityStatus {
  ACTIVE
  UNDER_INVESTIGATION
  SEIZED
  MIGRATED
}

enum SourceType {
  GOVERNMENT_REPORT
  LAW_ENFORCEMENT_NOTICE
  INDUSTRY_ANALYSIS
  RESEARCH_PUBLICATION
  SYSTEM_SIMULATION
}

enum EventType {
  GENESIS
  MARKET_MIGRATION
  FINANCIAL_SPIKE
  OPSEC_FAILURE
  SEIZURE
  LAW_ENFORCEMENT_ACTION
}

enum IdentifierType {
  BTC_WALLET
  XMR_WALLET
  ETH_WALLET
  PGP_FINGERPRINT
  TELEGRAM_HANDLE
  SESSION_ID
  TOX_ID
  JABBER_ID
  SIGNAL_NUMBER
  ALIAS
}

enum RelationType {
  OPERATES_ALIAS
  CONTROLS_WALLET
  USES_KEY
  COMMUNICATES_VIA
  VENDS_ON
  FUNDS_TRANSFER
  CO_CONSPIRATOR
  PRECURSOR_SUPPLIER
}

enum EvidenceType {
  BLOCKCHAIN_TX
  FORUM_POST
  MARKETPLACE_LISTING
  COMMUNICATION_INTERCEPT
  SEIZURE_REPORT
  OSINT_RECORD
}

// -----------------------------------------------------------------------------
// 1. Source Registry
// -----------------------------------------------------------------------------
model Source {
  id              String         @id @default(cuid())
  sourceCode      String         @unique @map("source_code") // e.g. "SRC-001-EUROPOL-RAPTOR"
  name            String
  publisher       String
  title           String         @db.VarChar(500)
  url             String         @db.VarChar(1000)
  publicationDate DateTime?      @map("publication_date")
  sourceType      SourceType     @map("source_type")
  description     String?        @db.Text
  classification  Classification @default(SOURCE_FACT)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  documents SourceDocument[]
  facts     Fact[]
  entities  Entity[]
  events    Event[]
  evidences Evidence[]

  @@map("sources")
}

// -----------------------------------------------------------------------------
// 2. Source Documents
// -----------------------------------------------------------------------------
model SourceDocument {
  id               String         @id @default(cuid())
  sourceId         String         @map("source_id")
  documentTitle    String         @map("document_title") @db.VarChar(500)
  author           String?
  sectionReference String?        @map("section_reference") @db.VarChar(255)
  rawTextExcerpt   String?        @map("raw_text_excerpt") @db.Text
  contentHash      String?        @map("content_hash") @db.VarChar(64)
  classification   Classification @default(SOURCE_FACT)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  source    Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  facts     Fact[]
  evidences Evidence[]

  @@index([sourceId])
  @@map("source_documents")
}

// -----------------------------------------------------------------------------
// 3. Facts (Granular Factual Grounding)
// -----------------------------------------------------------------------------
model Fact {
  id              String         @id @default(cuid())
  sourceId        String         @map("source_id")
  documentId      String?        @map("document_id")
  factKey         String         @unique @map("fact_key") // e.g. "RAPTOR_ARREST_COUNT_GLOBAL"
  statement       String         @db.Text
  numericValue    Float?         @map("numeric_value")
  unit            String?        @db.VarChar(50)
  jurisdiction    String?        @db.VarChar(100)
  timeframe       String?        @db.VarChar(100)
  confidenceScore Float          @default(1.0) @map("confidence_score")
  classification  Classification @default(SOURCE_FACT)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  source   Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  document SourceDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([documentId])
  @@map("facts")
}

// -----------------------------------------------------------------------------
// 4. Intelligence Entities (Suspects, Syndicates, Networks)
// -----------------------------------------------------------------------------
model Entity {
  id             String         @id @default(cuid())
  entityCode     String         @unique @map("entity_code") // e.g. "ent-001"
  primaryAlias   String         @map("primary_alias") @db.VarChar(100)
  category       DrugCategory
  colorHex       String         @default("#FF4500") @map("color_hex") @db.VarChar(10)
  riskScore      Int            @default(50) @map("risk_score")
  status         EntityStatus   @default(ACTIVE)
  firstSeen      DateTime?      @map("first_seen")
  lastActive     DateTime?      @map("last_active")
  summary        String?        @db.Text
  sourceId       String?        @map("source_id")
  classification Classification @default(DEMO_DATA)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  source            Source?            @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  identifiers       EntityIdentifier[]
  outgoingRelations Relationship[]     @relation("SourceEntity")
  incomingRelations Relationship[]     @relation("TargetEntity")
  events            Event[]
  cryptoIndicators  CryptoIndicator[]
  evidences         Evidence[]

  @@index([sourceId])
  @@map("entities")
}

// -----------------------------------------------------------------------------
// 5. Entity Identifiers (Wallets, PGP, Handles, Aliases)
// -----------------------------------------------------------------------------
model EntityIdentifier {
  id             String         @id @default(cuid())
  entityId       String         @map("entity_id")
  type           IdentifierType
  value          String         @db.VarChar(255)
  isPrimary      Boolean        @default(false) @map("is_primary")
  isVerified     Boolean        @default(false) @map("is_verified")
  platform       String?        @db.VarChar(100)
  balanceUSD     Float?         @default(0) @map("balance_usd")
  classification Classification @default(DEMO_DATA)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([value])
  @@map("entity_identifiers")
}

// -----------------------------------------------------------------------------
// 6. Entity Relationships
// -----------------------------------------------------------------------------
model Relationship {
  id              String         @id @default(cuid())
  sourceEntityId  String         @map("source_entity_id")
  targetEntityId  String         @map("target_entity_id")
  relationType    RelationType   @map("relation_type")
  confidence      Float          @default(0.8)
  evidenceSummary String?        @map("evidence_summary") @db.Text
  classification  Classification @default(DEMO_DATA)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  sourceEntity Entity @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity Entity @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@map("relationships")
}

// -----------------------------------------------------------------------------
// 7. Events & Timeline Milestones
// -----------------------------------------------------------------------------
model Event {
  id                  String         @id @default(cuid())
  eventCode           String?        @unique @map("event_code") // e.g. "tl-001"
  entityId            String?        @map("entity_id")
  sourceId            String?        @map("source_id")
  eventType           EventType      @map("event_type")
  timestamp           DateTime
  title               String         @db.VarChar(255)
  description         String?        @db.Text
  monthlyVolumeUSD    Float?         @default(0) @map("monthly_volume_usd")
  activeListingsCount Int?           @default(0) @map("active_listings_count")
  artifactHash        String?        @map("artifact_hash") @db.VarChar(64)
  classification      Classification @default(DEMO_DATA)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  entity Entity? @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([sourceId])
  @@map("events")
}

// -----------------------------------------------------------------------------
// 8. Locations & Geospatial Coordinates
// -----------------------------------------------------------------------------
model Location {
  id             String         @id @default(cuid())
  city           String         @db.VarChar(100)
  country        String         @db.VarChar(100)
  countryCode    String?        @map("country_code") @db.VarChar(10)
  latitude       Float
  longitude      Float
  classification Classification @default(DEMO_DATA)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  evidences Evidence[]

  @@map("locations")
}

// -----------------------------------------------------------------------------
// 9. Crypto Indicators
// -----------------------------------------------------------------------------
model CryptoIndicator {
  id             String         @id @default(cuid())
  entityId       String?        @map("entity_id")
  walletAddress  String         @map("wallet_address") @db.VarChar(255)
  currency       String         @default("BTC") @db.VarChar(10)
  totalVolumeUSD Float          @default(0) @map("total_volume_usd")
  coinJoinRounds Int            @default(0) @map("coinjoin_rounds")
  peakPeriod     String?        @map("peak_period") @db.VarChar(50)
  firstSeenTx    DateTime?      @map("first_seen_tx")
  classification Classification @default(DEMO_DATA)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  entity Entity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([walletAddress])
  @@map("crypto_indicators")
}

// -----------------------------------------------------------------------------
// 10. Evidence Artifacts
// -----------------------------------------------------------------------------
model Evidence {
  id             String         @id @default(cuid())
  evidenceCode   String         @unique @map("evidence_code") // e.g. "EVD-001"
  evidenceType   EvidenceType   @map("evidence_type")
  title          String         @db.VarChar(255)
  contentSnippet String?        @map("content_snippet") @db.Text
  entityId       String?        @map("entity_id")
  sourceId       String?        @map("source_id")
  documentId     String?        @map("document_id")
  locationId     String?        @map("location_id")
  artifactHash   String?        @map("artifact_hash") @db.VarChar(64)
  classification Classification @default(DEMO_DATA)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  entity   Entity?         @relation(fields: [entityId], references: [id], onDelete: SetNull)
  source   Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  document SourceDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  location Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([entityId])
  @@index([sourceId])
  @@index([documentId])
  @@index([locationId])
  @@map("evidences")
}
